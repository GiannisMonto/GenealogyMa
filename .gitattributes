# ===================================
# 族谱数字化管理平台 - Git Attributes
# ===================================

# ===== 文本处理 =====
* text=auto eol=lf

# 强制 Windows 文件使用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# ===== Go 文件 =====
*.go text diff=golang

# ===== 前端文件 =====
*.js text diff=javascript
*.jsx text diff=javascript
*.ts text diff=javascript
*.tsx text diff=javascript
*.vue text diff=javascript
*.css text diff=css
*.scss text diff=css
*.less text diff=css
*.html text diff=html
*.json text
*.json5 text
*.yaml text
*.yml text

# ===== 文档文件 =====
*.md text diff=markdown
*.mdx text diff=markdown
*.txt text
*.doc -diff
*.docx -diff
*.pdf -diff

# ===== 图片 =====
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text
*.bmp binary

# ===== 字体 =====
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary

# ===== 3D 模型 =====
*.glb binary
*.gltf text
*.obj text
*.fbx binary
*.stl binary
*.blend binary

# ===== 数据文件 =====
*.csv text
*.sql text
*.db binary
*.sqlite binary

# ===== 压缩文件 =====
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.rar binary

# ===== Docker =====
Dockerfile text
docker-compose.yml text
*.dockerignore text

