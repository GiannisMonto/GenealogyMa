# ===================================
# 族谱数字化管理平台 - 环境变量示例
# ===================================
# 复制此文件为 .env 并修改为实际值

# ===== 服务配置 =====
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
GIN_MODE=debug

# ===== PostgreSQL 数据库 =====
PG_HOST=10.100.34.3
PG_PORT=5432
PG_DBNAME=genealogy
PG_USER=user_iGyWJb
PG_PASSWORD=password_hcxtb5
PG_SSL_MODE=disable
PG_TIMEZONE=Asia/Shanghai

# ===== Redis 缓存 =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== JWT 认证 =====
JWT_SECRET=change-this-to-your-secret-key-in-production
JWT_EXPIRE_HOURS=24
JWT_REFRESH_EXPIRE_HOURS=168

# ===== 日志配置 =====
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# ===== 文件上传 =====
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx
UPLOAD_SAVE_PATH=./uploads

# ===== 跨域配置 =====
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization

# ===== 限流配置 =====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
